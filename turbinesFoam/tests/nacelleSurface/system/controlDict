FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.1;

deltaT          0.1;

writeControl    timeStep;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

libs
(
    "libturbinesFoam.so"
);

functions
{
    // Volume-integrate the distributed nacelle force field, so the
    // total-force preservation property (sum of cell force * V equals the
    // sum of the node forces, by the kernel partition of unity) can be
    // asserted by the integration test. The distributed field is the force
    // on the flow, i.e. minus the force on the body reported in the CSV.
    forceIntegral
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        fields          (force.nacelle);
        operation       volIntegrate;
        writeFields     false;
    }
}

