FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Rotor fixture with the rotational augmentation switched on and a degenerate
// two-point `cylinder` root profile (only +/-180 deg), mirroring the Phase VI
// case. Element 0 has no station in the zero-lift reference window [-10, 10]
// deg, so `correctRotationalAugmentation()` must skip it instead of crashing
// in `profileData::interpolate`; element 1 is the S809 polar and is corrected
// as usual.

turbine
{
    type            axialFlowTurbineALSource;
    active          on;

    axialFlowTurbineALSourceCoeffs
    {
        fieldNames          (U);
        selectionMode       cellSet;
        cellSet             turbine;
        origin              (0 0 0);
        axis                (1 0 0);
        verticalDirection   (0 0 1);
        freeStreamVelocity  (10 0 0);
        tipSpeedRatio       3.0;
        rotorRadius         0.45;

        dynamicStall
        {
            active          off;
            dynamicStallModel LeishmanBeddoes;
        }

        rotationalAugmentation
        {
            active          on;
            model           DuSelig;
            a               1;
            b               1;
            d               1;
        }

        endEffects
        {
            active          off;
            endEffectsModel Glauert;
        }

        blades
        {
            blade1
            {
                writePerf           true;
                writeElementPerf    true;
                elementType         actuatorLineElement;
                nElements           2;
                elementProfiles     (cylinder S809);
                elementData
                (
                    (0.0  0.05  0.0  0.04  0.25  0.0)
                    (0.0  0.45  0.0  0.04  0.25  0.0)
                );
            }
        }

        profileData
        {
            cylinder
            {
                // Two-point placeholder: no station in [-10, 10] deg.
                data
                (
                    (-180 0 1.1 0)
                    (180  0 1.1 0)
                );
            }

            S809
            {
                data (#include "S809.dat");
            }
        }
    }
}

// ************************************************************************* //
