FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// Generated from config/case.yaml. Do not edit by hand.

application pimpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 210;
deltaT 0.1;
writeControl runTime;
writeInterval 1;
purgeWrite 0;
writeFormat ascii;
writePrecision 10;
writeCompression off;
timeFormat general;
timePrecision 8;
runTimeModifiable true;
adjustTimeStep off;

libs
